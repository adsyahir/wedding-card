{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "wedding-card-arif",

  "main": ".open-next/worker.js",

  "compatibility_date": "2026-09-03",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "SITE_URL": "https://ariff-drsyazni.adsyahir.com"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-card-db",
      "database_id": "956a23e4-0bac-4f2f-9357-e2824098debb",
      "migrations_dir": "drizzle"
    },
    {
      "binding": "wedding_card_db",
      "database_name": "wedding-card-db",
      "database_id": "956a23e4-0bac-4f2f-9357-e2824098debb",
      "remote": false
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "wedding-card-assets"
    },
    {
      "bucket_name": "wedding-card-assets",
      "binding": "wedding_card_assets"
    }
  ],

  "routes": [
    {
      "pattern": "ariff-drsyazni.adsyahir.com",
      "custom_domain": true
    }
  ]
}