{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wedding-card-arif",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wedding-card-db",
			// LOCAL-ONLY placeholder. No remote D1 database exists yet — Miniflare
			// just keys its local SQLite store off this value. Before deploying,
			// run `wrangler d1 create wedding-card-db` and paste the real id here.
			"database_id": "d53c99d8-2853-4a35-89f3-6da853c8147f",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSETS_BUCKET",
			"bucket_name": "wedding-card-assets"
		}
	]
}
